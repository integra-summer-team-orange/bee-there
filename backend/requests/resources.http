### Get all resources
GET {{host}}/api/resources
Authorization: Bearer {{token}}
Accept: application/json

### Get all resources paged
GET {{host}}/api/resources?pageNumber=0&pageSize=10
Accept: application/json

### Get resource by ID (Happy Path)
GET {{host}}/api/resources/1
Authorization: Bearer {{token}}
Accept: application/json

### Get resource by ID (404 Error Path)
GET {{host}}/api/resources/9999
Authorization: Bearer {{token}}
Accept: application/json

### Create a resource (Happy Path)
POST {{host}}/api/resources
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "venueId": 1,
  "name": "Main Court",
  "activityType": "Basketball",
  "activityDescription": "Full court indoor basketball",
  "type": "INDOOR_SPORT",
  "capacity": 20,
  "hourlyRate": 50.00
}

### Create a resource (400 Validation Error Path)
POST {{host}}/api/resources
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "venueId": null,
  "name": "",
  "activityType": "Basketball",
  "activityDescription": "Missing required fields and invalid constraints",
  "type": "INVALID_TYPE_STRING",
  "capacity": -5,
  "hourlyRate": -10.00
}

### Create a resource with non-existent venue (400 FK violation)
POST {{host}}/api/resources
Content-Type: application/json

{
    "venueId": 999999,
    "name": "Orphaned Court",
    "activityType": "Basketball",
    "activityDescription": "References a venue that does not exist",
    "type": "INDOOR_SPORT",
    "capacity": 10,
    "hourlyRate": 25.00
}

### Update a resource (Happy Path)
PUT {{host}}/api/resources/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "venueId": 1,
  "name": "Main Court Updated",
  "activityType": "Volleyball",
  "activityDescription": "Net adjusted for volleyball",
  "type": "INDOOR_SPORT",
  "capacity": 24,
  "hourlyRate": 60.00
}

### Delete a resource (Happy Path)
DELETE {{host}}/api/resources/1
Authorization: Bearer {{token}}

### Delete a resource (404 Error Path)
DELETE {{host}}/api/resources/9999
Authorization: Bearer {{token}}