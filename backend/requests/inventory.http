### Get all inventory items
GET {{base_url}}/api/inventory

### Get inventory item by id (use id returned from Create request)
GET {{base_url}}/api/inventory/1

### Get inventory item by id error 404
GET {{base_url}}/api/inventory/999

### Create inventory item
POST {{base_url}}/api/inventory
Content-Type: application/json

{
    "venueId": "11111111-1111-1111-1111-111111111111",
    "name": "Chess set",
    "totalQuantity": 10,
    "availableQuantity": 7
}

### Create inventory item error 400 (missing required fields)
POST {{base_url}}/api/inventory
Content-Type: application/json

{
    "totalQuantity": 10
}

### Create inventory item error 400 (availableQuantity exceeds totalQuantity)
POST {{base_url}}/api/inventory
Content-Type: application/json

{
    "venueId": "11111111-1111-1111-1111-111111111111",
    "name": "Chess set",
    "totalQuantity": 5,
    "availableQuantity": 10
}

### Update inventory item (use id returned from Create request)
PUT {{base_url}}/api/inventory/1
Content-Type: application/json

{
    "venueId": "11111111-1111-1111-1111-111111111111",
    "name": "Chess set",
    "totalQuantity": 10,
    "availableQuantity": 4
}

### Update inventory item error 404
PUT {{base_url}}/api/inventory/999
Content-Type: application/json

{
    "venueId": "11111111-1111-1111-1111-111111111111",
    "name": "Chess set",
    "totalQuantity": 10,
    "availableQuantity": 4
}

### Delete inventory item (use id returned from Create request)
DELETE {{base_url}}/api/inventory/1

### Delete inventory item error 404
DELETE {{base_url}}/api/inventory/999
