### Get all venues
GET {{host}}/api/venues

### Get all venues paginated
GET {{host}}/api/venues?pageNumber=0&pageSize=10

### Get venue by id
GET {{host}}/api/venues/1

### Get venue by id error 404
GET {{host}}/api/venues/9999

### Create venue
POST {{host}}/api/venues
Content-Type: application/json

{
    "managedBy": 1,
    "name": "Guild Hall",
    "description": "The place for board games",
    "address": "Cluj-Napoca"
}

### Create venue only with required params
POST {{host}}/api/venues
Content-Type: application/json

{
    "managedBy": 1,
    "name": "Guild Hall 2",
    "address": "Cluj-Napoca"
}

### Create venue error 400
POST {{host}}/api/venues
Content-Type: application/json

{
    "managedBy": 1,
    "description": "The place for board games"
}

### Create venue error 400 (Whitespace name)
POST {{host}}/api/venues
Content-Type: application/json

{
    "managedBy": 1,
    "name": "   ",
    "address": "Cluj-Napoca"
}

### Create venue error 400 (Non-existent managedBy)
POST {{host}}/api/venues
Content-Type: application/json

{
    "managedBy": 9999,
    "name": "Ghost Venue",
    "description": "Managed by nobody",
    "address": "Nowhere"
}

### Update venue
PUT {{host}}/api/venues/1
Content-Type: application/json

{
    "id": 1,
    "managedBy": 1,
    "name": "Checkpoint",
    "description": "The place for board games",
    "address": "Piata Cipariu",
    "createdAt": "2026-07-21T10:00:00"
}

### Update venue error 404
PUT {{host}}/api/venues/9999
Content-Type: application/json

{
    "id": 9999,
    "managedBy": 1,
    "name": "Checkpoint",
    "address": "Piata Cipariu",
    "createdAt": "2026-07-21T10:00:00"
}

### Delete venue
DELETE {{host}}/api/venues/1

### Delete venue error 404
DELETE {{host}}/api/venues/9999
